{
  "name": "@bbs/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "build": "tsup src/index.ts --format esm --dts",
    "lint": "eslint --config ../../eslint.config.mjs \"src/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
